{
  "manifest_version": 3,
  "name": "Sheets Dark Mode",
  "version": "1.0.0",
  "description": "Full dark mode for Google Sheets: grid, toolbar, menus, dialogs and sidebars. Click the icon to toggle.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Sheets Dark Mode: click to toggle",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "css": ["dark.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
